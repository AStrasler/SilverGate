{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silvergate.invalid/schemas/collector-records/firewall_rule/1.0.0.schema.json",
  "title": "SilverGate collector-records/firewall_rule",
  "type": "object",
  "properties": {
    "recordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "collectorRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recordType": {
      "const": "firewall_rule"
    },
    "recordSchemaVersion": {
      "const": "1.0.0"
    },
    "observedWindow": {
      "$ref": "https://silvergate.invalid/schemas/common/1.0.0.schema.json#/$defs/window"
    },
    "payload": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "policyStore": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "policyStoreSource": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "policyStoreSourceType": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "direction": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "profiles": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1048576
              },
              "maxItems": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "filterRecordIds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 100000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "displayName",
        "policyStore",
        "policyStoreSource",
        "policyStoreSourceType",
        "enabled",
        "direction",
        "action",
        "profiles",
        "filterRecordIds"
      ],
      "additionalProperties": false
    },
    "fieldStates": {
      "$ref": "https://silvergate.invalid/schemas/common/1.0.0.schema.json#/$defs/fieldStates"
    },
    "extensions": {
      "$ref": "https://silvergate.invalid/schemas/common/1.0.0.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "recordId",
    "collectorRunId",
    "sourceId",
    "recordType",
    "recordSchemaVersion",
    "observedWindow",
    "payload",
    "fieldStates"
  ],
  "additionalProperties": false
}
