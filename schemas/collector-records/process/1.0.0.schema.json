{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silvergate.invalid/schemas/collector-records/process/1.0.0.schema.json",
  "title": "SilverGate collector-records/process",
  "type": "object",
  "properties": {
    "recordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "collectorRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recordType": {
      "const": "process"
    },
    "recordSchemaVersion": {
      "const": "1.0.0"
    },
    "observedWindow": {
      "$ref": "https://silvergate.invalid/schemas/common/1.0.0.schema.json#/$defs/window"
    },
    "payload": {
      "type": "object",
      "properties": {
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "creationTime": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "imagePath": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "parentPid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pid",
        "creationTime",
        "imagePath",
        "parentPid"
      ],
      "additionalProperties": false
    },
    "fieldStates": {
      "$ref": "https://silvergate.invalid/schemas/common/1.0.0.schema.json#/$defs/fieldStates"
    },
    "extensions": {
      "$ref": "https://silvergate.invalid/schemas/common/1.0.0.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "recordId",
    "collectorRunId",
    "sourceId",
    "recordType",
    "recordSchemaVersion",
    "observedWindow",
    "payload",
    "fieldStates"
  ],
  "additionalProperties": false
}
