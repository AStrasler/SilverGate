{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silvergate.invalid/schemas/collector-records/signature/1.0.0.schema.json",
  "title": "SilverGate collector-records/signature",
  "type": "object",
  "properties": {
    "recordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "collectorRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recordType": {
      "const": "signature"
    },
    "recordSchemaVersion": {
      "const": "1.0.0"
    },
    "observedWindow": {
      "$ref": "https://silvergate.invalid/schemas/common/1.0.0.schema.json#/$defs/window"
    },
    "payload": {
      "type": "object",
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "signer": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "validationMode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1048576
              },
              "maxItems": 100000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "signer",
        "status",
        "validationMode",
        "limitations"
      ],
      "additionalProperties": false
    },
    "fieldStates": {
      "$ref": "https://silvergate.invalid/schemas/common/1.0.0.schema.json#/$defs/fieldStates"
    },
    "extensions": {
      "$ref": "https://silvergate.invalid/schemas/common/1.0.0.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "recordId",
    "collectorRunId",
    "sourceId",
    "recordType",
    "recordSchemaVersion",
    "observedWindow",
    "payload",
    "fieldStates"
  ],
  "additionalProperties": false
}
